# ─────────────────────────────────────────────
# K&P Love Backend — Environment Variables
# Copy this file to .env and fill in the values
# NEVER commit .env to version control
# ─────────────────────────────────────────────

# App
APP_NAME="K&P Love"
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# Security — JWT
SECRET_KEY=your-super-secret-key-min-32-chars-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_URL=postgresql+asyncpg://postgres:your-password@db.your-project.supabase.co:5432/postgres

# Supabase Storage Buckets
STORAGE_BUCKET_AVATARS=avatars
STORAGE_BUCKET_MEMORIES=memories
STORAGE_BUCKET_VOICES=voices
STORAGE_BUCKET_FILES=files

# Google Maps
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Firebase Cloud Messaging
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json

# Redis (for Celery background tasks — optional)
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging
LOG_LEVEL=DEBUG
LOG_FILE=logs/app.log
